# SafeRoute backend environment template. Never commit real values.

APP_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LOG_LEVEL=INFO
AUTH_REQUIRED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side deletion worker only. Never expose with an EXPO_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_EXECUTION_ENABLED=false

DATABASE_URL=postgresql+asyncpg://saferoute:saferoute@localhost:5432/saferoute
DB_HOST=localhost
DB_USER=saferoute

ROUTING_ENGINE=compact
ROUTING_SEARCH_ALGORITHM=scipy_dijkstra
COMPACT_GRAPH_PATH=../data-science/compact_graph_res10.npz
NAVIGATION_SIDECAR_PATH=../data-science/navigation_sidecar_res10.npz
NAVIGATION_SIDECAR_REQUIRED=false
GRAPH_PATH=../data-science/chicago_walk.graphml
ROUTING_H3_RESOLUTION=10
ETL_H3_RESOLUTION=10
REPORT_H3_RESOLUTION=9
H3_PARENT_RESOLUTION=9
ROUTING_EDGE_SAMPLE_SPACING_M=30
ROUTING_EDGE_MAX_RISK_WEIGHT=0.65

LLM_MODE=mock
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

CHICAGO_DATA_APP_TOKEN=
REPORT_NLP_MODE=deterministic

# Generate random values with at least 32 characters and store them outside Git.
REPORTER_HASH_SECRET=<generate-a-random-secret>
WEBHOOK_SECRET=<generate-a-random-secret-or-leave-empty>

# Production entrypoint runs migrations only when an operator explicitly opts in.
RUN_MIGRATIONS=false
